{
    "name": "omnidrive/webdav",
    "type": "library",
    "description": "Omnidrive WebDAV: a collection of a WebDAV server - Nextcloud, ownCloud, Apache mod_dav, any - as an omnidrive drive, through league/flysystem-webdav (sabre/dav) - basic or digest authentication, a prefix.",
    "keywords": ["storage", "webdav", "nextcloud", "owncloud", "flysystem", "omnidrive"],
    "homepage": "https://github.com/glitchr-studio/omnidrive-webdav",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "league/flysystem-webdav": "^3.0",
        "omniscient/omnidrive": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnidrive\\Webdav\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnidrive\\Webdav\\Tests\\": "Tests/"}
    },
    "config": {"sort-packages": true}
}
